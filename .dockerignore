# Keep Docker build contexts small and avoid copying host state that would
# clobber the in-image installs / build outputs.
#
# Applies to the project-root build context used by every service image
# (auth-service, message-broker, transaction-service) and the gateway image.

# --- Node / Bun ---
node_modules
**/node_modules
.next
.out
dist
build

# --- Logs / runtime ---
*.log
dev.log
server.log

# --- Local DB (the containers provision their own via volumes) ---
db/*.db
db/*.db-journal

# --- VCS / editor ---
.git
.gitignore
.vscode
.idea

# --- Test runner artifacts ---
mini-services/test-runner/last-run.json

# --- Broker snapshot (broker writes to a mounted volume in the container) ---
mini-services/message-broker/snapshot.json
mini-services/*/snapshot.json

# --- Misc ---
download
upload
examples
tests
README.md
worklog.md
